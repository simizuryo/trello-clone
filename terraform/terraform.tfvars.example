# このファイルをコピーして terraform.tfvars を作成し、必要に応じて値を変更してください。
# terraform.tfvars 自体はコミットしません(.gitignore参照)。
#
#   cp terraform.tfvars.example terraform.tfvars

project_name = "trello-clone"
aws_region   = "ap-northeast-1"

# 初回applyでは container_image_tag はダミーのままで良い(ECRにイメージが無くてもリソース作成はできる)。
# 実際にECSタスクを起動させるには、backend/Dockerfileをビルドしてこのタグでpushしてから
# 再度applyするか `aws ecs update-service` で反映させる。
container_image_tag = "latest"
