<?xml version="1.0" encoding="UTF-8"?>
<included>
  <conversionRule conversionWord="mask" class="com.example.trelloclone.logging.MaskingConverter"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID:- } --- [%15.15t] [%X{requestId:-}] %-40.40logger{39} : %mask(%m%n%wEx)</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>
</included>
